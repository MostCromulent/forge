{
  "name": "forge-gui-web",
  "private": true,
  "description": "The browser half of Forge's web GUI. Maven runs the build; see README.md.",
  "type": "module",
  "scripts": {
    "build": "tsc && esbuild src/main/ts/app.ts --bundle --splitting --minify --format=esm --target=es2022 --sourcemap --log-level=warning --outdir=src/main/resources/web/js --chunk-names=chunks/[name]-[hash]",
    "watch": "esbuild src/main/ts/app.ts --bundle --splitting --format=esm --target=es2022 --sourcemap --outdir=src/main/resources/web/js --chunk-names=chunks/[name]-[hash] --watch",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/three": "0.169.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "preact": "10.29.8",
    "three": "0.169.0"
  }
}
